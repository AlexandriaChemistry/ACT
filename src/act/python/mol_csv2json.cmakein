import argparse, os, sys

# ACT python code, installed or next to this script in the source tree
sys.path.insert(1, "@ACT_PYTHON_LIB_PATH@")
sys.path.insert(1, os.path.dirname(os.path.abspath(__file__)))
from actutils import actdata
from mol_csv  import read_mol_csv, write_mol_json, fix_molecule_encoding

def parse_args():
    desc = "Convert alexandria.csv to a JSON file in UTF-8, see mol_csv.py"
    parser = argparse.ArgumentParser(description=desc)
    parser.add_argument("-f", "--infile", type=str, default=None,
                        help="The csv file, default alexandria.csv of the ACT data")
    parser.add_argument("-o", "--outfile", type=str, default="alexandria.json",
                        help="The JSON file, default alexandria.json")
    parser.add_argument("-fix_encoding", "--fix_encoding", action="store_true",
                        help="Repair text that was encoded as UTF-8 twice, such as by a spreadsheet")
    return parser.parse_args()

if __name__ == "__main__":
    args   = parse_args()
    infile = args.infile
    if not infile:
        infile = os.path.join(actdata(), "alexandria.csv")
    mols = read_mol_csv(infile)
    if args.fix_encoding:
        nfix = 0
        for mol in mols:
            n = fix_molecule_encoding(mol)
            if n > 0:
                print("Repaired %d texts of molecule %d %s" % ( n, mol["alexandria"], mol["iupac"] ))
            nfix += n
        print("Repaired %d texts in total" % nfix)
    write_mol_json(mols, args.outfile)
    print("Wrote %d molecules from %s to %s" % ( len(mols), infile, args.outfile ))
